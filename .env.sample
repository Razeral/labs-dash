# labs-dash deploy configuration. Copy to .env and fill in.

# AWS
AWS_REGION=ap-southeast-1
S3_BUCKET=labs-dash-site
CLOUDFRONT_DIST_ID=

# Baked into the bundle at build time (VITE_ prefix = visible to the client).
# The email allowed to use drag-and-drop re-tiering. Unset => edit mode never appears.
# This is a UX affordance, not a security control — overrides are localStorage-only.
VITE_OWNER_EMAIL=
